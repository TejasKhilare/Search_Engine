# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=Document Search Engine
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Postgres (with pgvector) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=docsearch
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536               # must match the embedding model (max 2000 for HNSW index)
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# ── JWT / Auth ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=docsearch-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=30   # tolerate two tabs refreshing at once

# ── Cookies ──────────────────────────────────────────────────
COOKIE_SECURE=false              # true in production (HTTPS only)
COOKIE_SAMESITE=lax              # lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_DOMAIN=                   # empty = current host

# ── MinIO (object storage) ───────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documents
MINIO_SECURE=false

# ── Uploads / ingestion ──────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=500
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_ENABLED=true
OCR_LANGUAGE=eng                 # Tesseract language codes, e.g. eng+hin
OCR_DPI=300
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
EMBEDDING_BATCH_SIZE=100
INGESTION_CONCURRENCY=2          # documents processed in parallel per process
INGESTION_STALE_AFTER_MINUTES=15 # re-queue "processing" docs older than this on startup

# ── Search / RAG ─────────────────────────────────────────────
SEARCH_TOP_K=10
SEARCH_MIN_SCORE=0.30
SEARCH_KEYWORD_MIN_COVERAGE=0.5
SEARCH_CANDIDATES=40
SEARCH_RRF_K=60
HNSW_EF_SEARCH=100
RAG_CONTEXT_CHUNKS=6
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_OUTPUT_TOKENS=800
RAG_TEMPERATURE=0.1

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=20/minute

# ── Maintenance ──────────────────────────────────────────────
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=60
SEARCH_LOG_RETENTION_DAYS=90
ORPHAN_OBJECT_MIN_AGE_MINUTES=60   # never touch files from uploads still in progress
