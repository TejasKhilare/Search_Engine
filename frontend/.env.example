# Copy to .env.local for local overrides (never commit real values).

# Development: where the Vite dev server proxies /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Production build: the backend's origin (no trailing slash, no /api path), e.g.
#   VITE_API_URL=https://api.example.com
# Leave empty when the frontend and API are served from the same origin.
VITE_API_URL=
